;;; socratic-html-export-test.el --- Real journal export regression checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'org)
(require 'ox-html)
(let ((load-file-name "/Users/jay/emacs/emacs-settings/org-export.el"))
  ;; Load only the HTML CSS selector and adapter, avoiding startup side effects.
  (with-temp-buffer
    (insert-file-contents load-file-name)
    (search-forward "(defvar my-org-selected-css")
    (beginning-of-line)
    (let ((start (point)))
      (search-forward "(add-hook 'org-export-filter-parse-tree-functions #'jay/org-socratic-tree)")
      (eval-region start (point)))))

(ert-deftest jay/socratic-html-real-journal ()
  (with-temp-buffer
    (insert-file-contents "/Users/jay/Dropbox/roam/journal/2026-11-17.org")
    (org-mode)
    (let* ((before (buffer-string))
           (tree (org-element-parse-buffer))
           (prompts (org-element-map tree 'src-block
                      (lambda (node)
                        (when (equal (org-element-property :language node) "user")
                          (org-element-property :value node)))))
           (my-org-selected-css jay/org-socratic-css)
           (org-export-use-babel t)
           (org-babel-default-header-args:user '((:exports . "results")))
           (html (org-export-as 'html nil nil nil '(:with-toc nil))))
      (should (equal before (buffer-string)))
      (should (= (length prompts) 7))
      (dolist (prompt prompts)
        (should (string-match-p (regexp-quote (org-html-encode-plain-text prompt)) html)))
      (should (string-match-p "class=\"prose codex-theme-section" html))
      (should (string-match-p "class=\"prose claude-code-theme-section" html))
      (should (string-match-p "class=\"model-banner terminal-model\">GPT-6-Astra medium" html))
      (should (string-match-p "class=\"model-banner terminal-model\">Claude Opus 5.5" html))
      (should (string-match-p "data:font/woff2;base64," html))
      (let ((css (with-temp-buffer
                   (insert-file-contents jay/org-socratic-css)
                   (buffer-string))))
        (dolist (file (directory-files jay/org-socratic-local-font-directory t "\\.otf\\'"))
          (let ((data (with-temp-buffer
                        (set-buffer-multibyte nil)
                        (insert-file-contents-literally file)
                        (base64-encode-string (buffer-string) t))))
            (should-not (string-match-p (regexp-quote data) css))
            (should (string-match-p (regexp-quote data) html))))
        (should-not (string-match-p "/fonts/tiempos-text/" html)))
      (let ((jay/org-socratic-local-font-directory "/nonexistent-socratic-font-directory/"))
        (should-error (jay/org-socratic-stylesheet) :type 'file-missing))
      (should-not (string-match-p "@import" html))
      (should-not (string-match-p "#+THEME:" html))
      ;; Other styles and backends must not activate the adapter.
      (let ((my-org-selected-css nil))
        (should-not (jay/org-socratic-active-p 'html))
        (should (eq tree (jay/org-socratic-tree tree 'html nil))))
      (should-not (jay/org-socratic-active-p 'latex)))))

(ert-deftest jay/socratic-html-kristen-dispatch-and-command ()
  (dolist (route '(dispatch command))
    (with-temp-buffer
      (insert-file-contents "/Users/jay/Dropbox/roam/journal/2026-11-17.org")
      (setq buffer-file-name "/Users/jay/Dropbox/roam/journal/2026-11-17.org"
            default-directory "/Users/jay/Dropbox/roam/journal/")
      (org-mode)
      (goto-char (point-min))
      (re-search-forward "^\\* Kristen$")
      ;; Output setting is added only to this temporary copy.  It tests that
      ;; narrowing honors subtree properties without changing the journal.
      (org-entry-put nil "EXPORT_FILE_NAME" "2026-11-17-kristen")
      (org-narrow-to-subtree)
      (goto-char (point-max))
      (let ((my-org-selected-css nil)
            (org-export-initial-scope 'buffer)
            (org-export-in-background nil)
            (org-export-show-temporary-export-buffer nil)
            (org-export-dispatch-use-expert-ui t)
            (current-prefix-arg nil)
            opened)
        (should (jay/org-socratic-active-p 'socratic-html))
        (cl-letf (((symbol-function 'org-open-file)
                   (lambda (file &rest _) (setq opened file))))
          (if (eq route 'dispatch)
              (let ((unread-command-events (list ?S ?o)))
                (org-export-dispatch))
            (call-interactively #'jay/org-export-socratic-html)))
        (should (buffer-narrowed-p))
        (should (equal (file-name-nondirectory opened) "2026-11-17-kristen.html"))
        (let ((html (with-temp-buffer (insert-file-contents opened) (buffer-string))))
          (should (string-match-p "<title>Kristen</title>" html))
          (should-not (string-match-p "write to Eva" html))
          (should (string-match-p "class=\"prose codex-theme-section" html))
          (should (string-match-p "class=\"prose claude-code-theme-section" html))
          (should (= 7 (with-temp-buffer
                         (insert html) (goto-char (point-min))
                         (let ((count 0))
                           (while (search-forward "class=\"user-block\"" nil t)
                             (setq count (1+ count))) count))))
          (should (string-match-p "data:font/otf;base64," html)))))))
